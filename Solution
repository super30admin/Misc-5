// TC  O(n)
// SC  O(1)

//  Sliding window keeps track of zeros flipped and adjusts the left pointer to maintain at most k zeros flipped.
class Solution {
  public int longestOnes(int[] nums, int k) {
    int left = 0;
    
    for (int right = 0; right < nums.length; right++) {
      // If nums[right] is 0, reduce k (flip this zero)
      if (nums[right] == 0) {
        k--;
      }
      
      
      if (k < 0) {
        
        if (nums[left] == 0) {
          k++;
        }
        left++;
      }
    }

    return nums.length - left;
  }
}
